{
  "extends": "@bluelovers/tsconfig/tsdx/index.json",
  "compilerOptions": {
    "importHelpers": true,
    "moduleResolution": "bundler",
    "rootDir": "src",
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": false,
    "noImplicitAny": false,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "test"
  ]
}
