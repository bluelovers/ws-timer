{
  "name": "fake-timer",
  "version": "2.0.2",
  "description": "Fake Timer API for node.js.",
  "keywords": [
    "settimeout",
    "duration",
    "task",
    "queue",
    "fake",
    "time",
    "timer",
    "create-by-yarn-tool",
    "create-by-tsdx"
  ],
  "homepage": "https://github.com/bluelovers/ws-timer/tree/master/packages/fake-timer#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-timer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-timer.git",
    "directory": "packages/fake-timer"
  },
  "license": "ISC",
  "author": "bluelovers",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.mjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "main": "dist/index.cjs",
  "unpkg": "dist/index.umd.production.min.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "pretest": "node --run test:tsc",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "node --run test:jest -- -u",
    "test:node": "tsx --test test/*.node-test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo Typescript checked",
    "test:tsd": "ynpx tsd",
    "prebuild": "pnpm run test",
    "build": "node --run build:tsdx && node --run build:dts:bundle",
    "build:dts:bundle": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --inline-declare-global & echo build:dts:bundle",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "node --run build:dts:copy && node --run build:dts:tsc:emit && node --run build:dts:copy",
    "build:dts:tsc:emit": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node",
    "ci:install": "echo ci:install",
    "ci:build": "echo ci:build",
    "preversion": "pnpm run build",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly_": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "nanoid": "<6 >=3.3.19"
  },
  "devDependencies": {
    "shuffle-array": "^1.0.1",
    "timed-queue": "^1.4.0"
  }
}
