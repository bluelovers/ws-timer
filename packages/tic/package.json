{
  "name": "tic2",
  "version": "1.0.4",
  "description": "intervals and timeouts using a delta tick. Useful for timing things with games.",
  "keywords": [
    "tick",
    "timer"
  ],
  "homepage": "https://github.com/bluelovers/ws-timer/tree/master/packages/tic#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-timer/issues"
  },
  "repository": {
    "type": "git",
